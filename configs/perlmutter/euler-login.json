{
  "name": "euler-login",
  "run_dir": "../../runs/perlmutter-login",
  "scheduler": "slurm",
  "cycles": 2,
  "poll_seconds": 15,
  "queue": "shared",
  "bank": "YOUR_BANK",
  "time": {"member": "2m", "analysis": "3m", "buffer": "3m"},
  "ensemble": {
    "size": 4,
    "slurm_args": ["-C", "cpu", "-c", "2", "--mem-per-cpu=1G"],
    "command": ["python3", "{config_dir}/../../components/euler_member.py"],
    "params": {
      "steps_per_cycle": 20,
      "overrides": {"number_cells": "63 63"},
      "perturb": {"sigma": 0.05, "seed_base": 1,
                  "keys": {"SHOCK.pressureLow": 10000, "SHOCK.pressureHigh": 100000,
                           "SHOCK.densityLow": 0.125, "SHOCK.densityHigh": 1.0}}
    },
    "retries": 1,
    "failures": {
      "NUMERICAL_INSTABILITY": {"exit_code": 20, "retries": 0}
    }
  },
  "analysis": {
    "bank": "YOUR_BANK_g",
    "slurm_args": ["-C", "gpu", "--gpus=1", "-c", "32"],
    "command": ["python3", "{config_dir}/../../components/mlef_analysis.py"],
    "retries": 1
  }
}
